{
  "name": "nuxt-effect-atom",
  "version": "0.0.1",
  "description": "Effect Atom for Nuxt: per-request registry, SSR hydration, and a process-shared layer memo map",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexanderop/nuxt-effect-atom.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "prepare": "nuxt-module-build build",
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "lint": "eslint .",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "measure": "node scripts/measure.mjs"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2"
  },
  "peerDependencies": {
    "@effect/atom-vue": "4.0.0-rc.109",
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@effect/atom-vue": "4.0.0-rc.109",
    "@nuxt/devtools": "^3.4.1",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "effect": "4.0.0-rc.109",
    "eslint": "^10.8.1",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "msgpackr-extract"
    ]
  },
  "bugs": {
    "url": "https://github.com/alexanderop/nuxt-effect-atom/issues"
  },
  "homepage": "https://github.com/alexanderop/nuxt-effect-atom#readme",
  "author": "Alexander Opalic",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "effect",
    "effect-ts",
    "effect-atom",
    "ssr",
    "vue"
  ],
  "packageManager": "pnpm@10.28.2"
}
