# dist/ is committed on purpose: this package is installed from git, and
# pnpm 10 refuses to run a git dependency's `prepare` script unless the
# consumer allowlists it in onlyBuiltDependencies. Shipping the build
# removes that step. Rebuild with `pnpm prepack` before pushing src changes.
